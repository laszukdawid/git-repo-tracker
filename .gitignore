# Build artifacts
/git-repo-tracker
*.app/
dist/

# Local config/cache that might leak into the tree during development
*.tmp

# Source screen recordings; the exported demo (docs/media/demo.gif) is committed.
*.mov

# MkDocs build output
/site/

# Local session memory of the Claude "remember" plugin — never part of the project
.remember/

# JetBrains project files (created when opening the repo in IntelliJ)
.idea/
